{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "semfile",
  "title": "SemFile",
  "description": "Semantic file search using multimodal embeddings",
  "icon": "extension-icon.png",
  "author": "jibk",
  "categories": ["Productivity"],
  "license": "MIT",
  "commands": [
    {
      "name": "search",
      "title": "Semantic Search",
      "description": "Search files by meaning using AI embeddings",
      "mode": "view"
    },
    {
      "name": "status",
      "title": "Index Status",
      "description": "View index statistics and storage usage",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "serverUrl",
      "type": "textfield",
      "required": false,
      "title": "Server URL",
      "description": "SemFile API server URL",
      "default": "http://localhost:19532"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.93.2",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "22.14.0",
    "@types/react": "19.0.8",
    "eslint": "^8.57.0",
    "prettier": "^3.4.2",
    "typescript": "^5.8.2",
    "react": "^19.0.0"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint"
  }
}
